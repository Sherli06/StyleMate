PORT=5000
NODE_ENV=development

# Select SQLite for a local, persistent database. Without DB_ENGINE=sqlite,
# the API tries MySQL first and falls back to SQLite if MySQL is unavailable.
DB_ENGINE=sqlite

# Optional MySQL settings (used when DB_ENGINE is not sqlite)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=stylemate_db

# Optional AI adapter credentials. Without provider credentials, recommendations
# use the explicitly labelled rule-based ranking.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=rule-matrix

# File Uploads
MAX_FILE_SIZE_MB=10

# Virtual Try-On Provider Configuration
# Supported providers: 'idm-vton' (free hosted Hugging Face ZeroGPU model) or 'fashn' (paid API)
TRYON_PROVIDER=idm-vton
IDM_VTON_SPACE=yisol/IDM-VTON
# Optional Hugging Face User Access Token (to skip anonymous queue when available)
HF_TOKEN=

# Optional FASHN Virtual Try-On API (https://docs.fashn.ai) - only needed if TRYON_PROVIDER=fashn
FASHN_API_KEY=

# For one-time admin provisioning, set ADMIN_EMAIL in the shell before running
# `npm run create-admin`. The generated temporary password is printed once.
